# Production flow:
# chamcongchua.com -> Cloudflare Tunnel -> localhost:3200 -> JobConnect -> PB_URL -> PocketBase localhost:8290

# Server-side upstream for API proxy routes.
# Keep this private/local when PocketBase runs on the same Linux server.
PB_URL=http://127.0.0.1:8290

# Optional for SSR/build-time direct access.
# Browser traffic still goes through same-origin /api/public/pb.
VITE_PB_URL=http://127.0.0.1:8290

# Server-side PocketBase access used by UID allocation APIs.
# Prefer PB_ADMIN_TOKEN on production, or use email/password for local setup.
PB_ADMIN_TOKEN=
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
