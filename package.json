{
  "name": "jobconnect-frontend",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production --update-env || npm run pm2:start",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "build:dev": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build --mode development",
    "deploy": "npm run deploy:pm2 && pm2 save",
    "deploy:full": "npm install && npm run deploy",
    "deploy:pm2": "npm run build && npm run pm2:reload",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pb:migrate-multitenancy": "node --env-file=.env scripts/migrate-multitenancy.mjs",
    "pb:migrate-tenant-transfer": "node --env-file=.env scripts/migrate-tenant-transfer.mjs --apply",
    "pb:audit-tenant-transfer": "node --env-file=.env scripts/migrate-tenant-transfer.mjs",
    "pb:migrate-company-login-identities": "node --env-file=.env scripts/migrate-company-login-identities.mjs",
    "pb:migrate-workers": "node scripts/migrate-workers.mjs",
    "pb:backfill-employment-snapshots": "node scripts/backfill-employment-snapshots.mjs",
    "pb:repair-employment-histories": "node scripts/repair-employment-histories.mjs",
    "pb:remove-retired-features": "node scripts/remove-retired-features-pb.mjs",
    "pb:init-uid-counters": "node --env-file=.env scripts/init-uid-counters.mjs",
    "pb:audit-duplicate-user-uids": "node --env-file=.env scripts/audit-duplicate-user-uids.mjs",
    "pb:repair-duplicate-user-uids": "node --env-file=.env scripts/repair-duplicate-user-uids.mjs",
    "test:uid-tools": "node --test scripts/uid-duplicate-tools.test.mjs",
    "pb:workforce-indexes": "node scripts/ensure-workforce-dashboard-indexes.mjs",
    "pb:app-settings-factory-scope": "node scripts/ensure-app-settings-factory-scope.mjs",
    "test:workforce-dashboard": "node --test --experimental-strip-types src/lib/workforce-dashboard.test.mjs",
    "pb:audit-cccd-versions": "node scripts/migrate-user-cccd-images.mjs",
    "pb:migrate-cccd-versions": "node scripts/migrate-user-cccd-images.mjs --apply",
    "pb:finalize-cccd-versions": "node scripts/migrate-user-cccd-images.mjs --finalize",
    "test:cccd-migration": "node --test scripts/migrate-user-cccd-images.test.mjs",
    "test:employment-history": "node --test --experimental-strip-types src/lib/employment-history-handler.test.ts",
    "test:excel": "node --test --experimental-strip-types src/lib/excel.test.ts",
    "pb:upgrade-worker-relations": "node scripts/upgrade-worker-relations.mjs",
    "test:employment-history-live": "node scripts/test-employment-history-live.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "embla-carousel-react": "^8.6.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.39.0",
    "input-otp": "^1.4.2",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "pocketbase": "^0.26.9",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-image-crop": "^11.1.2",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "uqr": "^0.1.3",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "^1.7.0",
    "@netlify/vite-plugin-tanstack-start": "^1.3.14",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eventsource": "^4.1.0",
    "globals": "^15.15.0",
    "nitro": "npm:nitro-nightly@^3.0.260522-beta",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1"
  }
}
